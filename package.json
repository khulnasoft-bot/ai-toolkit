{
  "private": true,
  "name": "ai-monorepo",
  "scripts": {
    "build": "turbo build --concurrency 2",
    "build:examples": "turbo build --filter=@example/*",
    "build:packages": "turbo --filter=@ai-toolkit/*",
    "build:core": "turbo build:core",
    "build:providers": "turbo build:providers",
    "build:adapters": "turbo build:adapters",
    "changeset": "changeset",
    "clean": "turbo clean",
    "dev": "turbo dev --no-cache --concurrency 25 --continue",
    "format:check": "pnpm prettier --check . && biome format",
    "format": "prettier --write . && biome format --write",
    "lint": "turbo lint",
    "lint:check": "biome check --diagnostic-level=error",
    "lint:markdown": "remark --frail .",
    "lint:fix": "biome check --write && pnpm eslint \"**/*.vue\" --fix",
    "prepare": "husky install",
    "update-references": "update-ts-references",
    "prettier-check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,svelte}\"",
    "prettier-fix": "prettier --write \"**/*.{js,ts,tsx,md,mdx,svelte}\"",
    "publint": "turbo publint",
    "test": "turbo --filter './packages/**' --filter './examples/**' --filter './tools/**' test",
    "test:core": "turbo test:core",
    "test:providers": "turbo test:providers",
    "test:adapters": "turbo test:adapters",
    "types:check": "turbo type-check && tsc --build",
    "types:full": "tsc --build tsconfig.with-examples.json",
    "types:check:raw": "pnpm run -r --parallel type-check",
    "types:build": "turbo type-check",
    "test:update": "turbo test:update --filter=!@example/*",
    "ci:release": "turbo clean && turbo build && changeset publish",
    "ci:version": "changeset version && node .github/scripts/cleanup-examples-changesets.mjs && pnpm install --no-frozen-lockfile",
    "clean-examples": "node .github/scripts/cleanup-examples-changesets.mjs && pnpm install --no-frozen-lockfile",
    "health-check": "node tools/scripts/health-check.mjs",
    "inventory": "node tools/scripts/inventory.mjs",
    "inventory:check": "node tools/scripts/inventory.mjs --check",
    "platform-inventory": "node tools/scripts/platform-inventory.mjs",
    "platform-inventory:check": "node tools/scripts/platform-inventory.mjs --check",
    "platform-registry": "pnpm --filter @ai-toolkit/platform generate-registry",
    "baseline": "node tools/scripts/baseline.mjs",
    "generate": "node tools/scripts/generate.mjs",
    "create-provider": "node tools/create-ai-provider/src/index.js",
    "validate-structure": "node tools/scripts/validate-structure.mjs",
    "arch:deps": "node tools/scripts/check-dependency-direction.mjs",
    "arch:capabilities": "node tools/scripts/generate-capability-matrix.mjs",
    "arch:capabilities:check": "node tools/scripts/generate-capability-matrix.mjs --check",
    "arch:validate": "pnpm arch:deps && pnpm arch:capabilities:check && pnpm validate-structure",
    "arch:inspect": "node tools/scripts/arch-inspect.mjs",
    "find-package": "node tools/scripts/find-package.mjs"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@changesets/cli": "2.27.10",
    "@playwright/test": "^1.61.1",
    "del-cli": "^5.1.0",
    "eslint-config-khulnasoft-ai": "workspace:*",
    "husky": "^8.0.0",
    "lint-staged": "15.5.1",
    "next": "16.3.6",
    "playwright": "^1.61.1",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "publint": "0.2.12",
    "react": "19.0.0-rc-cc1ec60d0d-20240607",
    "react-dom": "19.0.0-rc-cc1ec60d0d-20240607",
    "semver": "^7.8.5",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "update-ts-references": "^3.6.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "homepage": "https://studio.khulnasoft.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/ai-toolkit.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/khulnasoft/ai-toolkit/issues"
  },
  "keywords": [
    "ai"
  ],
  "packageManager": "pnpm@11.23.0",
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@sentry/cli",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "msw",
      "protobufjs",
      "sharp"
    ]
  }
}
